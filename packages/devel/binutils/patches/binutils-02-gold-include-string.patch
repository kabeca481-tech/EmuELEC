From: GNU binutils upstream
Subject: gold: include <string> in descriptors.cc

Fixes compilation with modern GCC where std::string is no longer included
transitively by other standard headers.

--- a/gold/descriptors.cc
+++ b/gold/descriptors.cc
@@ -26,6 +26,7 @@
 #include <cstdio>
 #include <cstring>
 #include <fcntl.h>
+#include <string>
 #include <unistd.h>
 
 #include "debug.h"
