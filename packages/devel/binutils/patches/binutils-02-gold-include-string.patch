From: GNU binutils upstream
Subject: gold: include <string> in errors.h

errors.h declares an API using std::string and must include its definition
directly, instead of relying on unrelated translation units to include it.

--- a/gold/errors.h
+++ b/gold/errors.h
@@ -24,6 +24,7 @@
 #ifndef GOLD_ERRORS_H
 #define GOLD_ERRORS_H
 
+#include <string>
 #include "gold-threads.h"
 
 namespace gold
